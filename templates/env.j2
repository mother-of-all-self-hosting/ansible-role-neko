TZ={{ neko_environment_variables_tz }}

{#
  The container images ship with `NEKO_SERVER_BIND=:8080` baked in, so without this
  line the server keeps listening on 8080 no matter what `neko_container_http_port`
  says, while the port publishing and the Traefik labels follow the variable.
#}
NEKO_SERVER_BIND=:{{ neko_container_http_port }}

NEKO_DESKTOP_SCREEN={{ neko_environment_variables_neko_desktop_screen }}
NEKO_DESKTOP_UNMINIMIZE={{ neko_environment_variables_neko_desktop_unminimize | to_json }}
NEKO_DESKTOP_UPLOAD_DROP={{ neko_environment_variables_neko_desktop_upload_drop | to_json }}

NEKO_MEMBER_PROVIDER={{ neko_environment_variables_neko_member_provider }}

{% if neko_environment_variables_neko_member_provider == 'multiuser' %}
NEKO_MEMBER_MULTIUSER_USER_PASSWORD={{ neko_environment_variables_neko_member_multiuser_user_password }}
NEKO_MEMBER_MULTIUSER_ADMIN_PASSWORD={{ neko_environment_variables_neko_member_multiuser_admin_password }}
{% endif %}

{% if neko_environment_variables_neko_member_provider == 'file' %}
NEKO_MEMBER_FILE_PATH={{ neko_environment_variables_neko_member_file_path }}
NEKO_MEMBER_FILE_HASH={{ neko_environment_variables_neko_member_file_hash | to_json }}
{% endif %}

{% if neko_environment_variables_neko_member_provider == 'object' %}
NEKO_MEMBER_OBJECT_USERS={{ neko_environment_variables_neko_member_object_users }}
{% endif %}

{% if neko_environment_variables_neko_session_file | length > 0 %}
NEKO_SESSION_FILE={{ neko_environment_variables_neko_session_file }}
{% endif %}

NEKO_WEBRTC_EPR={{ neko_environment_variables_neko_webrtc_epr }}
NEKO_WEBRTC_ICELITE={{ neko_environment_variables_neko_webrtc_icelite }}

{% if neko_environment_variables_neko_webrtc_ip_retrieval_url | length > 0 %}
NEKO_WEBRTC_IP_RETRIEVAL_URL={{ neko_environment_variables_neko_webrtc_ip_retrieval_url }}
{% endif %}

NEKO_SERVER_METRICS={{ neko_container_labels_traefik_metrics_enabled | to_json }}

{{ neko_environment_variables_additional_variables }}
